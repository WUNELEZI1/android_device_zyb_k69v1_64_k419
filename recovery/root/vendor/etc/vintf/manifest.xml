<?xml version="1.0" encoding="UTF-8"?>
<!--
    Trimmed VINTF device manifest for TWRP recovery (k69v1_64_k419 / MT6768).

    Declares ONLY the HALs that the recovery ramdisk actually serves:
      - android.hardware.health@2.1       (health HAL; started by init.recovery rc "on boot")
      - android.hardware.boot@1.2         (bootctrl / A/B slot switch from recovery)

    keymaster and gatekeeper are temporarily removed to fit the 32 MB boot
    limit. Re-enable them (and their manifest entries) when ramdisk size
    allows (see BoardConfig.mk TW_INCLUDE_CRYPTO).

    target-level 5 / sepolicy 31.0 align with PLATFORM_VERSION 12 (VNDK 31).
-->
<manifest version="4.0" type="device" target-level="5">
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
        <fqname>@2.1::IHealth/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.2::IBootControl/default</fqname>
    </hal>
    <sepolicy>
        <version>31.0</version>
    </sepolicy>
</manifest>
