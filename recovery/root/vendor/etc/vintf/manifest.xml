<?xml version="1.0" encoding="UTF-8"?>
<!--
    Trimmed VINTF device manifest for TWRP recovery (k69v1_64_k419 / MT6768).

    Declares ONLY the HALs that the recovery ramdisk actually serves:
      - android.hardware.keymaster@4.1  (FBE metadata decryption; service started
                                          by init.recovery.mt6768.rc on crypto.ready=1)
      - android.hardware.gatekeeper@1.0  (FBE decryption)
      - android.hardware.health@2.1       (health HAL; started by init.recovery rc "on boot")
      - android.hardware.boot@1.2         (bootctrl / A/B slot switch from recovery)

    The full stock MTK manifest (audio / camera / bluetooth / sensors / thermal /
    and the many vendor.mediatek.* HALs) is intentionally OMITTED: those HALs live
    on /vendor of the real system, not inside the recovery ramdisk. Declaring HALs
    that are not actually present would make hwservicemanager wait for (and fail
    on) services that never start in recovery.

    Matches PRODUCT_PACKAGES in device.mk and the service definitions in
    init.recovery.mt6768.rc. target-level 5 / sepolicy 31.0 align with
    PLATFORM_VERSION 12 (VNDK 31).
-->
<manifest version="4.0" type="device" target-level="5">
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <version>4.1</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
        <fqname>@4.0::IKeymasterDevice/default</fqname>
        <fqname>@4.1::IKeymasterDevice/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::IGatekeeper/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
        <fqname>@2.1::IHealth/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.2::IBootControl/default</fqname>
    </hal>
    <sepolicy>
        <version>31.0</version>
    </sepolicy>
</manifest>
